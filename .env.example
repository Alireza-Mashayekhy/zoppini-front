# Copy to .env.local and replace every placeholder before deploying.
# Server-only: never prefix these with NEXT_PUBLIC_.

# Internal Nest API base INCLUDING the /api prefix, e.g. http://backend:3000/api
# or https://internal-api.example.com/api. PRIVACY_API_URL + /privacy/consent
# is called from the Next route handler, never from the browser.
PRIVACY_API_URL=https://internal-backend.example.com/api

# Independent random secret (>= 32 chars). Must be identical in back/.env.
PRIVACY_PROXY_SECRET=REPLACE_WITH_RANDOM_32_CHAR_PROXY_SECRET

# Independent HMAC secret (>= 32 chars). Must be identical in back/.env.
PRIVACY_SIGNING_SECRET=REPLACE_WITH_RANDOM_32_CHAR_SIGNING_SECRET

# Exact public origin the browser uses (needed for the same-origin check).
PRIVACY_SITE_ORIGIN=https://zoppinico.com

# Public, non-secret flags.
NEXT_PUBLIC_ENABLE_GOOGLE_ANALYTICS=false
NEXT_PUBLIC_ANALYTICS_CAMPAIGNS=
NEXT_PUBLIC_API_URL=https://zoppinico.com/api
